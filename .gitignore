.env

__pycache__/
*.pyc

venv/
.venv/
.vscode/
.idea/
*.egg-info/

# Streamlit local secrets (credentials never in git)
.streamlit/secrets.toml

# Ignore models/ artifacts. Cache directory tracked but only its
# documentation files; data files live locally and are mirrored to
# R2 via src/snapshot_for_cloud.py.
models/*
!models/reports/
!models/cache/
models/cache/*
!models/cache/*.md
!models/cache/*.txt
!models/cache/*.toml         # streamlit_cloud_secrets_template.toml is template-only
!models/cache/dashboard_results/
models/cache/dashboard_results/*
!models/cache/dashboard_results/325_blacklist_summary.csv

# Stale checkout artifacts under price_cache, model output, etc.
*.parquet
*.db
*.bin
backtest_profile.bin
optuna_studies.db

# Stale autopilot-era HTML reports (pre-dashboard, not needed in repo)
models/reports/

# Frozen cache snapshots (for reproducible hypothesis runs). Large, local-
# only, regenerated on demand via src/snapshot_cache.py create.
models/snapshots/

# Local IDE / tool config (Claude Code, VSCode, etc.)
.claude/
src/.claude/

# Windows installer package
*.msix

# Documentation: scratch/working docx files stay local; anything under
# docs/ at any depth is intentional project documentation and IS tracked.
# The `!docs/**/*.docx` pattern covers docs/foo.docx AND docs/specs/foo.docx
# AND any deeper nesting — the prior `!docs/*.docx` was depth-1 only and
# silently dropped specs files (e.g. docs/specs/Dashboard_Rebuild_Spec.docx).
*.docx
!src/paper_trader_user_guide.docx
!docs/**/*.docx

models/cache/*.toml.txt# V3 study scratch files
inspect_*.py
extract_track2*.py
compare_studies.py
v3_track1_*.log
v3_track2_*.log

# Cloud secrets (never commit)
*secrets*FILLED*
*secrets*.toml*

# Zip archives (typically scratch / data exports)
*.zip

# Source-zipping scratch
make_src_zip.py
# Add to .gitignore if not already present
*.log
spot_check.py
check_*.py
track_*.py
study_progress.py
progress_*.py
best_continuous.py
touch_snapshot.py
rescue_save_continuous.py
_spec_extracted.txt

# SP1500 paused-state diagnostic logs at repo root — kept locally per
# project audit decision (2026-05-11) to document the paused workstream
# state, but never re-committed. The base `*.log` rule above already
# catches these; this section just records the intent for future readers.
sp1500_*.log
