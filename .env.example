# Template for the project's local .env file. Copy this to .env, fill in
# real values, and never commit the resulting .env (it's gitignored).
#
# Every variable below is read directly from the codebase at runtime.
# Group ordering reflects how often each block matters: data sources
# first, cloud sync second, and optional runtime knobs last.
#
# Streamlit-side secrets (cloud dashboard auth, R2 read credentials
# served from st.secrets) live in a separate template at
# models/cache/streamlit_cloud_secrets_template.toml — they are pasted
# into Streamlit Cloud's secret store, not into this file.

# ============================================================
# Equity data sources
# ============================================================
# FRED economic data API (free tier; used by src/macro_signals.py for
# the macro regime signal). Sign up:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub insider transactions (free tier; used by
# src/finnhub_insider_signals.py for the insider cluster-buying alt
# signal). Sign up: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ============================================================
# Options data sources
# ============================================================
# Polygon (rebranded as Massive.com in late 2025). Required by
# src/options/polygon.py for historical OHLCV on expired option
# contracts — replaced Tradier as the historical-data source after
# Tradier was found to return null for expired OCCs at all plan tiers.
# Sign up: https://polygon.io/signup
POLYGON_API_KEY=your_polygon_api_key_here

# Tradier — used by src/options/tradier.py for live chain snapshots,
# current quotes, and (Section 9+) paper-trade / live execution.
# Sign up: https://developer.tradier.com — generate a personal access
# token in the Sandbox environment. Production token is required only
# once live paper-trade goes online.
TRADIER_SANDBOX_TOKEN=your_tradier_sandbox_token_here
TRADIER_PRODUCTION_TOKEN=your_tradier_production_token_here

# Tradier environment selector — "sandbox" or "production". Defaults
# to "sandbox" if unset; src/options/tradier.py reads this to pick
# which token to use.
TRADIER_ENV=sandbox

# ============================================================
# Cloud / R2 (Cloudflare R2, S3-compatible)
# ============================================================
# Used by src/snapshot_for_cloud.py to push dashboard snapshots to R2
# and by src/data_source.py (in cloud mode) to read them back. Get
# these from Cloudflare → R2 → API tokens; the upload token needs
# Object Read + Write on the bucket.
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://your_account_id_here.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_r2_bucket_name_here

# ============================================================
# Paper Trader runtime knobs (optional — defaults work)
# ============================================================
# Most local workflows leave these unset. Snapshot-mode runners
# (rescore_baseline.py, run_hypothesis.py, run_optuna_parallel.py,
# scripts/research/*) set them programmatically from their --snapshot
# argument. Set them manually only when you want to run a one-off
# command in snapshot mode without going through a runner.
#
# PAPER_TRADER_DATA_ROOT — absolute path to a snapshot directory under
# models/snapshots/equities/. When set, all fetchers read from the
# snapshot instead of hitting live data sources. Unset = live mode.
#PAPER_TRADER_DATA_ROOT=

# PAPER_TRADER_ARCHITECTURE — "legacy" or "regime-dependent". The
# regime-dependent arch is the current production track; legacy is
# kept for reproducibility against older promoted studies.
#PAPER_TRADER_ARCHITECTURE=regime-dependent

# PAPER_TRADER_MACRO_VERSION — "v1" or "v2". v2 is the current default
# in src/macro_signals.py; v1 is kept for reproducibility.
#PAPER_TRADER_MACRO_VERSION=v2

# PAPER_TRADER_OBJECTIVE — Optuna objective override
# (src/optuna_runner.py). Defaults are study-specific; only set when
# you intentionally want to override the locked objective.
#PAPER_TRADER_OBJECTIVE=

# PAPER_TRADER_STORAGE — "sqlite" (default) or "journal". Selects the
# Optuna storage backend in src/optuna_runner.py /
# src/run_optuna_parallel.py.
#PAPER_TRADER_STORAGE=sqlite

# PAPER_TRADER_TPE_STARTUP — integer; TPE n_startup_trials override
# for Optuna sampling. Default 200.
#PAPER_TRADER_TPE_STARTUP=200

# PAPER_TRADER_REQUIRE_DEFENSIVE_PCT — float in [0,1]. Optional gate
# in src/optuna_runner.py / src/run_optuna_parallel.py that requires
# at least this share of trials to clear the defensive screen.
#PAPER_TRADER_REQUIRE_DEFENSIVE_PCT=0
