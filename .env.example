# Tradier API tokens (Phase 2 Section 2 — options data).
# Sign up at https://developer.tradier.com, generate a personal access
# token in the Sandbox environment. Production token is required only
# once Section 9 paper-trade goes live.
TRADIER_SANDBOX_TOKEN=
TRADIER_PRODUCTION_TOKEN=

# Tradier environment selector — "sandbox" or "production".
# Defaults to sandbox if unset.
TRADIER_ENV=sandbox
